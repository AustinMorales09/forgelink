<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Typed HTTP client for ForgeLink plus offline store-and-forward (SQLite queue).
    Shared by the WPF station and the MAUI handheld so both behave identically when Wi-Fi drops.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ForgeLink.Contracts\ForgeLink.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>
</Project>
