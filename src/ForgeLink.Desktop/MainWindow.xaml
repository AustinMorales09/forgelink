<Window x:Class="ForgeLink.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ForgeLink.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:StationViewModel}"
        Title="ForgeLink Station" Width="1280" Height="820" WindowState="Maximized"
        Background="{StaticResource Bg}" FontFamily="Segoe UI">

    <Window.InputBindings>
        <!-- F5 = sync now, F9 = report: large-key shortcuts for gloved operators / keypad overlays. -->
        <KeyBinding Key="F5" Command="{Binding SyncNowCommand}" />
        <KeyBinding Key="F9" Command="{Binding ReportCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Header: station identity, machine state, connectivity, sync queue -->
        <Border DockPanel.Dock="Top" Background="#0B1016" Padding="18,12" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Border CornerRadius="14" Padding="14,6" Margin="8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Good}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                        <Setter Property="Background" Value="{StaticResource Bad}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Text" Value="ONLINE" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                            <Setter Property="Text" Value="OFFLINE – saving locally" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Border CornerRadius="14" Padding="14,6" Margin="8,0" Background="#2A3542">
                        <TextBlock>
                            <Run Text="Queued: " /><Run Text="{Binding PendingSync, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text="  Rejected: " /><Run Text="{Binding RejectedSync, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                    </Border>
                    <Button Content="Sync (F5)" Command="{Binding SyncNowCommand}" MinHeight="36" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Station.StationName}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Station.MachineCode}" Foreground="{StaticResource Muted}" Margin="14,0" VerticalAlignment="Center" />
                    <Border CornerRadius="14" Padding="14,6" Margin="8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#4B5563" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MachineState}" Value="Running"><Setter Property="Background" Value="{StaticResource Good}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding MachineState}" Value="Down"><Setter Property="Background" Value="{StaticResource Bad}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding MachineState}" Value="Idle"><Setter Property="Background" Value="{StaticResource Warn}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock>
                            <Run Text="{Binding MachineState, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text="{Binding MachineReason, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Event log -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Height="170">
            <ListBox ItemsSource="{Binding Log}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" FontFamily="Cascadia Mono, Consolas" FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="warn">
                                            <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- Left: scan, operator, work order -->
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="SCAN (badge EMP:…, work order WO-…, component lot label)" />
                        <!-- Keyboard-wedge scanners type into this box and press Enter. It keeps focus between actions. -->
                        <TextBox x:Name="ScanBox" Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" FontSize="24">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ProcessScanCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Style="{StaticResource Label}" Text="OPERATOR" />
                        <TextBlock Text="{Binding OperatorBadge, TargetNullValue='— scan badge —'}" FontSize="20" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="WORK ORDER" />
                        <TextBlock FontSize="30" FontWeight="Bold" Text="{Binding WorkOrder.Number, TargetNullValue='No work order loaded'}" />
                        <TextBlock Foreground="{StaticResource Muted}">
                            <Run Text="{Binding WorkOrder.Sku, Mode=OneWay}" /> <Run Text="{Binding WorkOrder.ItemDescription, Mode=OneWay}" />
                        </TextBlock>
                        <ProgressBar Height="22" Margin="0,12,0,4" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Foreground="{StaticResource Accent}" Background="{StaticResource Bg}" />
                        <TextBlock>
                            <Run Text="{Binding WorkOrder.QuantityCompleted, Mode=OneWay}" FontWeight="Bold" /><Run Text=" / " />
                            <Run Text="{Binding WorkOrder.QuantityOrdered, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding WorkOrder.Uom, Mode=OneWay}" />
                            <Run Text="   scrap " /><Run Text="{Binding WorkOrder.QuantityScrapped, Mode=OneWay}" />
                            <Run Text="   status " /><Run Text="{Binding WorkOrder.Status, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="Start" Command="{Binding StartCommand}" Style="{StaticResource Primary}" />
                            <Button Content="Pause" Command="{Binding PauseCommand}" />
                            <Button Content="Complete" Command="{Binding CompleteCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right: production reporting -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Report production" FontSize="22" FontWeight="Bold" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="GOOD QTY" />
                            <TextBox Text="{Binding GoodQuantity, UpdateSourceTrigger=PropertyChanged}" FontSize="28" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="SCRAP QTY" />
                            <TextBox Text="{Binding ScrapQuantity, UpdateSourceTrigger=PropertyChanged}" FontSize="28" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Label}" Text="SCRAP REASON (required with scrap)" />
                    <ComboBox IsEditable="True" Text="{Binding ScrapReason, UpdateSourceTrigger=PropertyChanged}" FontSize="18" MinHeight="44">
                        <ComboBoxItem>DIMENSIONAL</ComboBoxItem>
                        <ComboBoxItem>SURFACE_FINISH</ComboBoxItem>
                        <ComboBoxItem>SETUP_PIECE</ComboBoxItem>
                        <ComboBoxItem>MATERIAL_DEFECT</ComboBoxItem>
                    </ComboBox>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="COMPONENT LOT (backflush)" />
                            <TextBox Text="{Binding ComponentLot, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="QTY USED" />
                            <TextBox Text="{Binding ComponentQuantity, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,18,0,0">
                        <Button Content="Weigh &amp; count" Command="{Binding ReadScaleCommand}" />
                        <Button Content="Report (F9)" Command="{Binding ReportCommand}" Style="{StaticResource Primary}" MinWidth="180" />
                        <Button Content="Reprint label" Command="{Binding ReprintCommand}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Label}" Text="LAST LABEL (ZPL)" />
                    <TextBox Text="{Binding LastZpl, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="11" FontFamily="Cascadia Mono, Consolas" Height="110" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
