@inherits LayoutComponentBase
@implements IDisposable
@inject StoreAndForwardForgeLinkApi Api

<header class="m-top @(Api.IsOnline ? "" : "m-offline")">
    <a href="" class="m-brand"><span class="fl-logo"><Icon Name="logo" /></span>ForgeLink</a>
    <span class="m-status" role="status">
        <Icon Name="@(Api.IsOnline ? "wifi" : "wifi-off")" />
        @(Api.IsOnline ? "Online" : "Offline")
        @if (_pending > 0)
        {
            <span class="m-badge">@_pending to sync</span>
        }
    </span>
</header>

<main class="m-main">@Body</main>

<nav class="m-bottom" aria-label="Main">
    <NavLink href="" Match="NavLinkMatch.All"><Icon Name="home" /><span>Home</span></NavLink>
    <NavLink href="inventory/move"><Icon Name="move" /><span>Move</span></NavLink>
    <NavLink href="inventory/count"><Icon Name="count" /><span>Count</span></NavLink>
    <NavLink href="inventory" Match="NavLinkMatch.All"><Icon Name="search" /><span>Lookup</span></NavLink>
    <NavLink href="lots/trace"><Icon Name="trace" /><span>Trace</span></NavLink>
</nav>

@code {
    private int _pending;

    protected override async Task OnInitializedAsync()
    {
        Api.ConnectivityChanged += OnChanged;
        Api.Queue.Changed += OnQueueChanged;
        _pending = await Api.Queue.CountAsync();
    }

    private void OnChanged(object? sender, bool online) => InvokeAsync(StateHasChanged);

    private void OnQueueChanged(object? sender, EventArgs e) => InvokeAsync(async () =>
    {
        _pending = await Api.Queue.CountAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        Api.ConnectivityChanged -= OnChanged;
        Api.Queue.Changed -= OnQueueChanged;
    }
}
