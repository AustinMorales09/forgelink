@if (Notice is not null)
{
    <div class="@Notice.CssClass" role="@(Notice.Kind == NoticeKind.Error ? "alert" : "status")">
        <Icon Name="@(Notice.Kind switch { NoticeKind.Error => "alert", NoticeKind.Success => "ok", _ => "info" })" />
        <span>@Notice.Message</span>
    </div>
}

@code {
    [Parameter] public Notice? Notice { get; set; }
}
