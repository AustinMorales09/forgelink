@* Stacked hourly column chart (good + reject) drawn as inline SVG: no JS charting dependency, works in WebView. *@
@if (Points.Count == 0)
{
    <EmptyState Icon="chart" Title="No production counts in this window yet" />
}
else
{
    const double width = 760, height = 200, pad = 34, top = 8;
    var max = NiceMax(Points.Max(p => p.Good + p.Reject));
    var slot = (width - pad) / Points.Count;
    var bar = Math.Clamp(slot * 0.62, 4, 44);
    var plot = height - top;
    <svg class="fl-chart" viewBox="0 0 @width @(height + 22)" role="img" aria-label="Hourly throughput, good and rejected parts">
        @for (var g = 0; g <= 4; g++)
        {
            var y = height - plot * g / 4;
            <line class="@(g == 0 ? "fl-axis-line" : "fl-grid-line")" x1="@pad" y1="@F(y)" x2="@width" y2="@F(y)" />
            @SvgText(pad - 8, y + 3.5, (max * g / 4).ToString("0", CultureInfo.InvariantCulture), "end")
        }
        @for (var i = 0; i < Points.Count; i++)
        {
            var p = Points[i];
            var x = pad + i * slot + (slot - bar) / 2;
            var gh = p.Good / (double)max * plot;
            var rh = p.Reject / (double)max * plot;
            <rect class="fl-bar-good" x="@F(x)" y="@F(height - gh)" width="@F(bar)" height="@F(gh)" rx="@F(Math.Min(4, bar / 4))"><title>@Format.Local(p.HourUtc): @p.Good good</title></rect>
            @if (rh > 0)
            {
                <rect class="fl-bar-reject" x="@F(x)" y="@F(height - gh - rh - 1.5)" width="@F(bar)" height="@F(rh)" rx="@F(Math.Min(3, bar / 4))"><title>@p.Reject rejects</title></rect>
            }
            @SvgText(x + bar / 2, height + 16, p.HourUtc.ToLocalTime().ToString("HH:00", CultureInfo.InvariantCulture), "middle")
        }
    </svg>
}

@code {
    [Parameter] public IReadOnlyList<ThroughputPointDto> Points { get; set; } = [];

    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    /// <summary>Axis maximum = 4 × a "nice" gridline step (1, 2, 2.5, 5 × 10ⁿ), e.g. 137 → 4 × 50 = 200, so labels are round numbers.</summary>
    private static int NiceMax(int value)
    {
        var raw = Math.Max(1, value) / 4.0;
        var magnitude = Math.Pow(10, Math.Floor(Math.Log10(raw)));
        var step = new[] { 1, 2, 2.5, 5, 10 }.Select(s => s * magnitude).First(s => s >= raw);
        return (int)Math.Max(1, Math.Ceiling(step)) * 4;
    }

    // <text> is a reserved Razor tag, so SVG text labels are emitted as markup (values are numeric/hour strings only).
    private static MarkupString SvgText(double x, double y, string label, string anchor) =>
        new($"<text class=\"fl-axis\" x=\"{F(x)}\" y=\"{F(y)}\" text-anchor=\"{anchor}\">{System.Net.WebUtility.HtmlEncode(label)}</text>");
}
