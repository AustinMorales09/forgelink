@inherits PollingComponent

<NoticeBanner Notice="LoadError" />

@if (!Loaded)
{
    <p class="fl-muted">Loading machines…</p>
}
else if (_machines.Count == 0)
{
    <EmptyState Icon="machine" Title="No machines configured">@(Line is null ? "Machines appear here once they are seeded or synced." : $"Nothing on {Line}.")</EmptyState>
}
else
{
    <div class="fl-tiles">
        @foreach (var m in _machines)
        {
            <article class="fl-tile @Format.StateClass(m.State)">
                <header>
                    <strong>@m.Code</strong>
                    <span class="fl-pill">@m.State</span>
                </header>
                <p class="fl-muted">@m.Description</p>
                @if (!string.IsNullOrEmpty(m.Reason))
                {
                    <p class="fl-reason">@m.Reason</p>
                }
                <dl>
                    <div><dt>Job</dt><dd>@(m.CurrentWorkOrder ?? "—")</dd></div>
                    <div><dt>Since</dt><dd>@Format.Ago(m.StateChangedAtUtc)</dd></div>
                    <div><dt>Heartbeat</dt><dd>@Format.Ago(m.LastHeartbeatUtc)</dd></div>
                </dl>
            </article>
        }
    </div>
}

@code {
    private IReadOnlyList<MachineStatusDto> _machines = [];

    [Parameter] public string? Line { get; set; }

    protected override bool Wants(ShopFloorChange change) => change.Kind is ShopFloorChangeKind.Machine or ShopFloorChangeKind.WorkOrder;

    protected override async Task LoadAsync(CancellationToken ct) =>
        _machines = await Api.GetMachinesAsync(Line, ct);
}
