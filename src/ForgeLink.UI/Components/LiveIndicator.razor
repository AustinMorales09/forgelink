@* "Live · updated 4s ago" chip. Turns red when the last refresh failed, so stale numbers are never mistaken for live ones. *@
<span class="fl-live @(Stale ? "fl-live-stale" : "")" role="status">@(Stale ? "Stale" : "Live") · updated @Format.Ago(LastRefreshUtc)</span>

@code {
    [Parameter] public DateTime? LastRefreshUtc { get; set; }
    [Parameter] public bool Stale { get; set; }
}
