<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    One ASP.NET Core host, three UI/API styles:
      /api/*          REST API (controllers) for stations, handhelds, gateways
      /integration/*  ASP.NET Core MVC operations console (server-rendered)
      /               Blazor Server dashboard using the shared ForgeLink.UI components
      /hubs/shopfloor SignalR push for HMIs / andon boards
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>forgelink-web-dev</UserSecretsId>
    <!-- XML doc comments feed the OpenAPI document (summaries on every endpoint). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ForgeLink.Application\ForgeLink.Application.csproj" />
    <ProjectReference Include="..\ForgeLink.Infrastructure\ForgeLink.Infrastructure.csproj" />
    <ProjectReference Include="..\ForgeLink.UI\ForgeLink.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>
</Project>
